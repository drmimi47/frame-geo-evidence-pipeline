{"total_results":2,"page":1,"per_page":2,"results":[{"id":243888,"title":"Biodiversity of the former Kakhovka Reservoir","hide_title":false,"hide_leaderboard":false,"description":"The Biodiversity of the Former Kakhovka Reservoir Project was created to collect data on the formation of habitats on the former bottom of the former Kakhovka Reservoir. The Kakhovka Reservoir was destroyed by the Russian occupiers by blowing up the dam of the Kakhovka Hydroelectric Power Station on June 6, 2023. The Kakhovka Reservoir was located on the Dnipro River in southern Ukraine. The reservoir was the largest in Ukraine in terms of water volume. It covered an area of 2,115 square kilometers.\r\n\r\n","slug":"biodiversity-of-the-former-kakhovka-reservoir","project_type":"collection","delegated_project_id":null,"is_delegated_umbrella":false,"banner_color":"#74ac00","place_id":216144,"user_id":3593135,"admins":[{"id":3004560,"user_id":3593135,"project_id":243888,"role":"manager","user":{"id":3593135,"login":"ivanmoysiyenko","spam":false,"suspended":false,"created_at":"2020-09-11T12:16:15+00:00","login_autocomplete":"ivanmoysiyenko","login_exact":"ivanmoysiyenko","name":"Ivan Moysiyenko","name_autocomplete":"Ivan Moysiyenko","orcid":null,"icon":"https://static.inaturalist.org/attachments/users/icons/3593135/thumb.jpeg?1599826575","observations_count":31888,"identifications_count":11026,"journal_posts_count":0,"activity_count":42914,"species_count":2277,"annotated_observations_count":2,"universal_search_rank":31888,"roles":[],"site_id":null,"icon_url":"https://static.inaturalist.org/attachments/users/icons/3593135/medium.jpeg?1599826575"}}],"user_ids":[3301501,3326263,3593135,7259002,10538344],"location":null,"icon":"https://www.inaturalist.org/attachment_defaults/general/span2.png","icon_file_name":null,"header_image_url":"https://static.inaturalist.org/projects/243888-cover-6117231b3c395a43c1fef3c10bea21a1.jpg?1747479258","header_image_file_name":"IMG_20240522_113250.jpg","header_imag